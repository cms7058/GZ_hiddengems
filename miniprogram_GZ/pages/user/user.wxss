page {
  height: 100vh;
  background: #f4f1e8;
  overflow: hidden;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.user-scroll {
  flex: 1;
  min-height: 0;
}

.user-content {
  min-height: 100%;
  padding: 28rpx 24rpx calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.floating-back {
  position: fixed;
  left: 24rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 20;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(205, 235, 211, 0.88);
  color: #2f6b4f;
  border: 1rpx solid rgba(47, 107, 79, 0.18);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(25, 49, 39, 0.16);
}

.profile-card,
.panel,
.tip {
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(31, 49, 39, 0.08);
}

.profile-card {
  padding: 28rpx;
  display: flex;
  gap: 22rpx;
  align-items: center;
}

.profile-summary {
  flex: 1;
  min-width: 0;
}

.edit-button {
  flex: none;
  margin: 0;
  width: 64rpx;
  height: 36rpx;
  padding: 0;
  border: 1rpx solid #c7d8cc;
  border-radius: 6rpx;
  background: #f5f8f3;
  color: #1f5f45;
  font-size: 18rpx;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #1f5f45;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-avatar {
  display: block;
  background: #e7ece5;
}

.name,
.subtitle,
.form-title,
.tip-title {
  display: block;
}

.name {
  color: #203127;
  font-size: 36rpx;
  font-weight: 800;
}

.sync-error {
  display: block;
  margin-top: 8rpx;
  color: #a14137;
  font-size: 20rpx;
  line-height: 1.35;
}

.profile-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(20, 34, 27, 0.42);
}

.profile-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 18rpx 44rpx rgba(20, 34, 27, 0.25);
}

.profile-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #203127;
  font-size: 30rpx;
  font-weight: 800;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #526157;
  font-size: 40rpx;
  line-height: 44rpx;
}

.avatar-button,
.save-button {
  height: 76rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-button {
  flex: none;
  width: 132rpx;
  background: #edf3ea;
  color: #1f5f45;
}

.form-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
}

.nickname-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: #f6f4ed;
  color: #203127;
  font-size: 26rpx;
  box-sizing: border-box;
}

.save-button {
  min-width: 160rpx;
  background: #1f5f45;
  color: #ffffff;
  font-weight: 700;
}

.profile-edit-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.save-row {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.stats-grid {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 12rpx;
}

.stat {
  position: relative;
  width: calc((100% - 36rpx) / 4);
  flex: none;
  min-height: 132rpx;
  padding: 16rpx 8rpx;
  border-radius: 8rpx;
  background: #edf3ea;
  color: #5c6b60;
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
  box-sizing: border-box;
  overflow: hidden;
}

.stat-tap {
  background: #dceee1;
  border: 1rpx solid #79a98a;
  color: #285d42;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.45);
}

.stat-tap:active {
  transform: scale(0.97);
  background: #cce5d3;
}

.stat-tap .value {
  color: #17623f;
}

.checkin-stat .value {
  margin-top: 6rpx;
}

.checkin-risk-tags {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  left: 8rpx;
  display: flex;
  justify-content: center;
  gap: 4rpx;
  overflow: hidden;
}

.risk-tag {
  max-width: 100%;
  padding: 3rpx 5rpx;
  border-radius: 5rpx;
  color: #ffffff;
  font-size: 15rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.risk-tag.warning {
  background: #c9453d;
}

.risk-tag.suspicious {
  background: #df792e;
}

.risk-tag.watch {
  background: #d8aa26;
  color: #493b0c;
}

.value {
  display: block;
  margin-top: 12rpx;
  color: #193127;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.value.small {
  font-size: 22rpx;
}

.row-value {
  max-width: 58%;
  color: #526157;
  font-size: 24rpx;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selectable {
  user-select: text;
}

.panel {
  margin-top: 22rpx;
  padding: 8rpx 28rpx;
}

.row {
  min-height: 92rpx;
  border-bottom: 1rpx solid #edf0e8;
  color: #223127;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row:last-child {
  border-bottom: 0;
}

.tip {
  margin-top: 22rpx;
  padding: 28rpx;
  color: #5d6c62;
  font-size: 26rpx;
  line-height: 1.5;
}

.tip-title {
  margin-bottom: 8rpx;
  color: #1f5f45;
  font-size: 30rpx;
  font-weight: 800;
}
