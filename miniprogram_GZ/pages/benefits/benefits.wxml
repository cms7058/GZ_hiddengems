<view class="page"><navigation-bar title="积分权益" back="true" color="#193127" background="rgba(244,241,232,0.96)"></navigation-bar>
<view class="balance"><text>可用权益积分</text><text class="value">{{summary.benefit_points}}</text><text>累计探秘积分 {{summary.explore_points}}</text></view>
<view class="tabs"><view wx:for="{{tabs}}" wx:key="key" class="tab {{activeTab===item.key?'active':''}}" data-key="{{item.key}}" bindtap="onTab">{{item.label}}</view></view>
<scroll-view class="scroll" scroll-y><view wx:for="{{visible}}" wx:key="id" class="card"><text class="name">{{item.name_zh}}</text><text class="desc">{{item.description_zh}}</text><text>{{item.points_cost}} 积分 · 有效期 {{item.valid_days}} 天</text><button class="redeem" data-id="{{item.id}}" bindtap="onRedeem">确认兑换</button></view><view class="records"><text class="title">积分与兑换记录</text><view wx:for="{{summary.ledgers}}" wx:key="id"><text>{{item.action}} {{item.change_points}} 分</text></view><view wx:for="{{summary.redemptions}}" wx:key="id"><text>{{item.benefit_name}} · {{item.status}}</text></view></view></scroll-view></view>
