page,.page{height:100vh;background:#f4f1e8}.page{display:flex;flex-direction:column}.balance,.card,.records{margin:20rpx 24rpx;padding:22rpx;border-radius:8rpx;background:#fff}.balance text{display:block;color:#52705d}.balance .value{font-size:52rpx;color:#193127;font-weight:800}.tabs{display:flex;padding:0 24rpx;gap:12rpx}.tab{flex:1;padding:16rpx 4rpx;border-radius:8rpx;background:#e8eee6;text-align:center;font-size:23rpx}.tab.active{background:#1f5f45;color:#fff}.scroll{flex:1;min-height:0;padding-bottom:130rpx}.card .name,.card .desc{display:block}.name{font-weight:800;color:#193127}.desc{margin:10rpx 0;color:#647166}.redeem{float:right;margin-top:-46rpx;background:#1f5f45;color:#fff;font-size:22rpx}.records{color:#536357}.title{display:block;margin-bottom:12rpx;font-weight:800;color:#193127}
